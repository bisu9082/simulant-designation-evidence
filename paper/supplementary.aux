\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces Every exact permutation test across panel constructions, descriptor spaces and statistics. Values are one-sided $p$. Bold marks $p<0.05$ before correction. The last column is the smallest Benjamini--Hochberg value over the eighteen tests of that panel construction. Dimensions are the retained coordinate counts after the correlation filter of Section~\ref {meth:orderinvariance}.}}{9}{table.2}\protected@file@percent }
\newlabel{tab:ablation}{{S2}{9}{Every exact permutation test across panel constructions, descriptor spaces and statistics. Values are one-sided $p$. Bold marks $p<0.05$ before correction. The last column is the smallest Benjamini--Hochberg value over the eighteen tests of that panel construction. Dimensions are the retained coordinate counts after the correlation filter of Section~\ref {meth:orderinvariance}}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces Five ways of accounting for the search, applied to the eighteen tests of each panel configuration. The Westfall-Young min-$P$ value \cite  {westfall1993} is exact for the dependence among the tests, since all eighteen share one enumeration of designations; $m_{\mathrm  {eff}}$ approximates that dependence from the eigenvalues of the correlation matrix of the eighteen nulls \cite  {liji2005}, used as a Bonferroni divisor. On the primary panel no scheme returns anything below 0.05 and on the smaller panel only the pre-specified-statistic scheme does, while the fourth configuration, which differs from the second by two class labels, is below 0.05 under every scheme.}}{10}{table.3}\protected@file@percent }
\newlabel{tab:family}{{S3}{10}{Five ways of accounting for the search, applied to the eighteen tests of each panel configuration. The Westfall-Young min-$P$ value \cite {westfall1993} is exact for the dependence among the tests, since all eighteen share one enumeration of designations; $m_{\mathrm {eff}}$ approximates that dependence from the eigenvalues of the correlation matrix of the eighteen nulls \cite {liji2005}, used as a Bonferroni divisor. On the primary panel no scheme returns anything below 0.05 and on the smaller panel only the pre-specified-statistic scheme does, while the fourth configuration, which differs from the second by two class labels, is below 0.05 under every scheme}{table.3}{}}
