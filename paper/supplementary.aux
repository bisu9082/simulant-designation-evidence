\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces What the permutation test could have detected. One-sided exact $p$ for the mean-difference statistic as the incumbent simulants are moved $\delta $ typical nearest-neighbour separations closer to the eleven agents, with the rest of each panel unchanged and the null taken from the unmodified distances. On the primary panel the test crosses $\alpha = 0.05$ at $\delta = 0.23$. The shaded band spans that value and the median deficit the incumbent compounds actually carry, 0.493; the deficit falls below the detectable value only at sarin.}}{14}{figure.1}\protected@file@percent }
\newlabel{fig:mde}{{S1}{14}{What the permutation test could have detected. One-sided exact $p$ for the mean-difference statistic as the incumbent simulants are moved $\delta $ typical nearest-neighbour separations closer to the eleven agents, with the rest of each panel unchanged and the null taken from the unmodified distances. On the primary panel the test crosses $\alpha = 0.05$ at $\delta = 0.23$. The shaded band spans that value and the median deficit the incumbent compounds actually carry, 0.493; the deficit falls below the detectable value only at sarin}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S6}{\ignorespaces GFN2-xTB local reactivity at phosphorus for the six phosphorus-bearing compounds. $f^{+}(\mathrm  {P})$ is the condensed Fukui index for nucleophilic attack at phosphorus. $\omega $ is the global electrophilicity index in the definition of Parr et al.~\cite  {parr1999} with $\eta $ equal to half the HOMO--LUMO gap, and $\omega _k = \omega f^{+}(\mathrm  {P})$ is the composite local electrophilicity of Domingo et al.~\cite  {domingo2016}. The two reactivity conventions disagree about VX and the text says why.}}{14}{table.6}\protected@file@percent }
\newlabel{tab:plocal}{{S6}{14}{GFN2-xTB local reactivity at phosphorus for the six phosphorus-bearing compounds. $f^{+}(\mathrm {P})$ is the condensed Fukui index for nucleophilic attack at phosphorus. $\omega $ is the global electrophilicity index in the definition of Parr et al.~\cite {parr1999} with $\eta $ equal to half the HOMO--LUMO gap, and $\omega _k = \omega f^{+}(\mathrm {P})$ is the composite local electrophilicity of Domingo et al.~\cite {domingo2016}. The two reactivity conventions disagree about VX and the text says why}{table.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces Two quantities that sit outside every distance used in this work. (a) Local electrophilicity against Mulliken charge at phosphorus for the six phosphorus-bearing compounds (Section~\ref {res:plocal}). (b) The Parr electrophilicity index, an exact function of the orbital energies that enter the electronic space, which itself enters no distance anywhere in this work (Section~\ref {M-meth:spaces}) and on which the three nerve agents rank lowest of the eleven agents. The principal components of the two spaces are in Figure~\ref {M-fig:spaces}a and b.}}{15}{figure.2}\protected@file@percent }
\newlabel{fig:plocal}{{S2}{15}{Two quantities that sit outside every distance used in this work. (a) Local electrophilicity against Mulliken charge at phosphorus for the six phosphorus-bearing compounds (Section~\ref {res:plocal}). (b) The Parr electrophilicity index, an exact function of the orbital energies that enter the electronic space, which itself enters no distance anywhere in this work (Section~\ref {M-meth:spaces}) and on which the three nerve agents rank lowest of the eleven agents. The principal components of the two spaces are in Figure~\ref {M-fig:spaces}a and b}{figure.2}{}}
